# Secrets
.env

# Everything the app writes: vector store, per-video records, uploaded videos,
# downloaded model weights. All regenerable; deleting data/ is a full reset.
data/

# Test media is large and usually local to a machine. Drop this line if you
# want a shared fixture set committed.
media/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Model weights are fetched, not committed: ultralytics auto-downloads
# yolo11n.pt on first use (dev) and the Docker image bakes it in (prod).
yolo*.pt

# Model caches these libraries create outside data/
.paddlex/
runs/


# Logs and scratch
*.log
.frames/
