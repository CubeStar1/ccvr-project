# Copy to .env. Never commit the real file -- .gitignore excludes it.
#
# The library itself reads only the environment: in your own code call
# `vidra.configure(env_file=".env")` or `load_dotenv()`, or hand the keys
# over instead: OpenAI(api_key=...), Supabase(url=..., key=...),
# vidra.configure(hf_token=...). A variable already set is never overridden.

# --- keys: set only the ones you use ----------------------------------------
OPENAI_API=                   # or OPENAI_API_KEY: OpenAI() and OpenAIEmbedder()
ANTHROPIC_API_KEY=            # Anthropic()
HF_TOKEN=                     # pyannote's FIRST download (gated); cached, it loads without one
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # sb_secret_...      ingest writes
SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_... consumer reads

# Which model fills each role is chosen in code, not here:
#
#   Models(vlm=OpenAI("gpt-6-luna"), llm=Anthropic(), embedder=LocalEmbedder())
#
# A key for any other server (Gemini, Groq, Mistral, ...) is yours to name:
# put it here under any variable and pass it as Chat(..., api_key=os.environ[...]).

# ---------------------------------------------------------------------------
# Where runs write. NOT read from this file -- `vidra/shared/config/paths.py`
# resolves it before `.env` is loaded, so it must be a real process variable.
# Listed here because this is where people look for knobs.
#   VIDRA_DATA=/srv/vidra   out/, prompts.json, aggregates.json
#   VIDRA_WEIGHTS=/models       share one checkpoint cache between checkouts
# ---------------------------------------------------------------------------
