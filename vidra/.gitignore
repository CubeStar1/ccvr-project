# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------------------
# Media and model weights: large, and not ours to redistribute.
# The pipeline takes any video as an argument; nothing here is required to
# run it. Model weights are downloaded on first use by ultralytics/HF.
# ---------------------------------------------------------------------------
/samples/
/weights/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.ts
*.m4v
*.h264
*.h265
*.wav
*.pt
*.onnx
*.engine

# ---------------------------------------------------------------------------
# Everything a run writes, under one root: `data/out/<video-id>/`, and the
# custom prompts beside it. The outputs are reproducible from a source video; a
# frame store runs to hundreds of MB (95 MB for a five-minute file at 1920px).
# `VIDRA_DATA` moves the lot; `VIDRA_DATA=.` restores the old layout.
# ---------------------------------------------------------------------------
/data/

# `recovery.recreate --out` defaults here. Rebuilt frames, byte-identical to
# the store they verify against, and regenerated on demand.
/rebuilt/

