{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embedded",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "document",
    "version",
    "video_id"
  ],
  "properties": {
    "document": {
      "const": "embedded"
    },
    "version": {
      "type": "integer"
    },
    "video_id": {
      "type": "string"
    },
    "timeline_fingerprint": {
      "type": "string"
    },
    "embedder": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
